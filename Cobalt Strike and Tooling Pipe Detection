// Description: Detects creation of named pipes associated with known C2 frameworks, adversary tools, and malware families
// MITRE ATT&CK: T1021.003, T1071, T1105
// Data Source: DeviceEvents (NamedPipeEvent)
// Severity: High
// False Positives: Red team tools, penetration testing frameworks, administrative remote execution tools (PsExec in IT environments)

let minTimeRange = ago(7d);

let badPipeNames = dynamic([
    // PsExec / remote execution tools
    "\\psexec",
    "\\paexec",
    "\\remcom",
    "\\csexec",
    "\\csexecsvc",
    "\\svcctl",

    // APT / malware-specific pipes
    "\\isapi_http",
    "\\isapi_dg",
    "\\isapi_dg2",
    "\\sdlrpc",
    "\\ahexec",
    "\\winsession",
    "\\lsassw",
    "\\46a676ab7f179e511e30dd2dc41bd388",
    "\\9f81f59bc58452127884ce513865ed20",
    "\\e710f28d59aa529d6792ca6ff0ca1b34",
    "\\rpchlp_3",
    "\\NamePipe_MoreWindows",
    "\\pcheap_reuse",
    "\\gruntsvc",
    "\\583da945-62af-10e8-4902-a8f205c72b2e",
    "\\bizkaz",
    "\\atctl",
    "\\userpipe",
    "\\iehelper",
    "\\comnap",

    // Credential dumping pipes
    "\\lsadump",
    "\\cachedump",
    "\\wceservicepipe",

    // Cobalt Strike / post-exploitation frameworks
    "\\jaccdpqnvbrrxlaf",
    "\\postex_ssh_",
    "\\postex_",
    "\\Posh",
    "\\MSSE-",
    "\\status_",
    "\\msagent_",

    // Covenant / PoshC2
    "\\posh",
    "\\poshc2"
]);

DeviceEvents
| where Timestamp > minTimeRange
| where ActionType == "NamedPipeEvent"
| extend Fields = todynamic(AdditionalFields)
| extend FileOperation = tostring(Fields.FileOperation),
         PipeName = tostring(Fields.PipeName)
| where FileOperation == "File created"
| where isnotempty(PipeName)
| where PipeName has_any (badPipeNames)
| project
    Timestamp,
    DeviceName,
    PipeName,
    ActionType,
    FileOperation,
    InitiatingProcessAccountDomain,
    InitiatingProcessAccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessFolderPath
| order by Timestamp desc
