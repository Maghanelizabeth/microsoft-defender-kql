// Description: Detects behavioral patterns associated with credential dumping, PowerShell obfuscation, and privilege escalation tool execution in post-compromise scenarios
// Data Source: DeviceProcessEvents
// Severity: High (Credential Access / Privilege Escalation)
// MITRE ATT&CK: T1003, T1059, T1068
// False Positives: Red team exercises, penetration testing, IT security tooling, administrative scripting

DeviceProcessEvents
| where Timestamp > ago(7d)  // last 7 days, adjust timeframe as needed
| where InitiatingProcessFileName != ""  // process was started by another process
| where (
    ProcessCommandLine has_any ("-enc", "-EncodedCommand", "Invoke-Mimikatz", "Invoke-TokenManipulation", "Invoke-PrivilegeEscalation") or
    InitiatingProcessFileName  in ("mimikatz.exe", "powershell.exe", "cmd.exe", "whoami.exe", "net.exe")
)
| extend AccountName = InitiatingProcessAccountName
| project Timestamp, DeviceName, InitiatingProcessFileName, ProcessCommandLine, AccountName, InitiatingProcessRemoteSessionIP
| order by Timestamp desc
