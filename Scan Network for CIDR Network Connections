// Description: Identifies and summarizes device connections to known malicious CIDR ranges
// MITRE ATT&CK: T1071, T1105
// Data Source: DeviceNetworkEvents
// Severity: High
// Hunt Type: Threat Intelligence / Network IOC
// False Positives: Shared hosting providers, VPN ranges, cloud infrastructure overlap

let CIDR1 = "185.186.244.0/24";
let CIDR2 = "172.94.9.0/24";
DeviceNetworkEvents
| where ipv4_is_in_range(RemoteIP, CIDR1)
    or ipv4_is_in_range(RemoteIP, CIDR2)
| summarize
    FirstSeen=min(Timestamp),
    LastSeen=max(Timestamp),
    ConnectionCount=count()
    by RemoteIP, DeviceName, RemotePort, ActionType
| sort by ConnectionCount desc
