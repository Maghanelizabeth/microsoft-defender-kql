// Description: Detects use of runas.exe with /savecred flag indicating potential credential reuse or privilege escalation via stored credentials
// Data Source: DeviceProcessEvents
// Severity: Medium to High (Privilege Escalation / Credential Abuse)
// MITRE ATT&CK: T1078, T1548, T1550
// False Positives: IT administrators, automated deployment scripts, legitimate admin tooling

DeviceProcessEvents
| where FileName == "runas.exe"
| extend TargetAccount = extract(@'user:(.*?) ', 1, ProcessCommandLine)
| where ProcessCommandLine contains "/savecred"
| project Timestamp, DeviceName, TargetAccount, ProcessCommandLine
