// Description: Detects suspicious use of PowerShell, Certutil, MSHTA, scheduled tasks, and archive tooling commonly associated with attacker activity
// MITRE ATT&CK: T1059, T1218, T1105, T1053
// Data Source: DeviceProcessEvents
// Severity: High
// False Positives: Administrative automation, software deployment tools, patch management utilities

DeviceProcessEvents
| where Timestamp > ago(7d)
| where 
    (
        FileName in~ ("powershell.exe", "pwsh.exe") and
        ProcessCommandLine has_any ("-EncodedCommand", "IEX", "Invoke-WebRequest", "DownloadString")
    )
    or 
    (
        FileName == "certutil.exe" and
        ProcessCommandLine has_any ("-urlcache", "-split", "-decode")
    )
    or 
    (
        FileName == "mshta.exe" and
        ProcessCommandLine has_any ("http", ".hta")
    )
    or 
    (
        FileName == "schtasks.exe" and
        ProcessCommandLine has_all ("/create", "/tn", "/tr")
    )
    or
    (
        FileName endswith ".rar" and
        ProcessCommandLine has_any ("-hp", "-p", "-r")
    )
| project Timestamp, DeviceName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId, DeviceId
| order by Timestamp desc
| where InitiatingProcessFileName !in~ ("explorer.exe", "svchost.exe", "services.exe")
| where InitiatingProcessFileName !in ("gc_worker.exe", "gc_extension_service.exe", "microsoft.management.services.cloudmanageddesktop.agent.exe")
| where ProcessCommandLine !contains ("powershell  -ExecutionPolicy Bypass -NoProfile -Command") 
| where InitiatingProcessCommandLine !contains ("PatchMyPC")
| where ProcessCommandLine !contains ("Launch Adobe CCXProcess")
| where ProcessCommandLine !contains ("azcmagent_check_updates.ps1")
| where ProcessCommandLine !contains ("schtasks /Create /TN TVInstallRestore /TR ")
