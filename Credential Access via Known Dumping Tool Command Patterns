// Description: Detects execution of known credential dumping and authentication abuse keywords associated with tools like Mimikatz and Kerberos ticket extraction
// Data Source: DeviceProcessEvents
// Severity: High (Credential Access)
// MITRE ATT&CK: T1003, T1558, T1550
// False Positives: Security testing tools, red team activity, authorized penetration testing, admin troubleshooting

DeviceProcessEvents
| where ProcessCommandLine has_any ("sekurlsa", "logonpasswords", "kerberos", "wdigest")
| project Timestamp, DeviceName, InitiatingProcessAccountName, ProcessCommandLine, InitiatingProcessCommandLine
