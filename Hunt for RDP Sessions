// Description: Detects inbound Remote Desktop Protocol (RDP) connections on port 3389 originating from public IP addresses, with geo-location enrichment for threat analysis
// MITRE ATT&CK: T1021.001 (Remote Desktop Protocol), T1133 (External Remote Services)
// Data Source: DeviceNetworkEvents
// Severity: High
// False Positives: VPN gateways, remote IT administration, cloud bastion hosts, managed service providers

let IPRegex = '[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}';
DeviceNetworkEvents
| where ActionType contains "connection"
| where LocalPort == 3389
| where ActionType != "ConnectionAttempt"
| where ActionType != "ListeningConnectionCreated"
// Add column wich displays if the remote IP is private
| extend FourToSixPrivate = extract(IPRegex, 0, RemoteIP)
| extend RemoteIPIsPrivate = iff(ipv4_is_private(RemoteIP), 1, iff(ipv4_is_private(FourToSixPrivate), 1, 0))
// Remove comment below if you only want to see inbound connections from public IP addresses.
| where RemoteIPIsPrivate == 0
| extend GeoIPInfo = geo_info_from_ip_address(RemoteIP)
| extend country = tostring(parse_json(GeoIPInfo).country), state = tostring(parse_json(GeoIPInfo).state), city = tostring(parse_json(GeoIPInfo).city), latitude = tostring(parse_json(GeoIPInfo).latitude), longitude = tostring(parse_json(GeoIPInfo).longitude)
