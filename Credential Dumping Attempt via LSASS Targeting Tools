// Description: Detects potential credential dumping attempts targeting LSASS using high-risk system utilities and Sysinternals tools
// Data Source: DeviceProcessEvents
// Severity: High (Credential Access)
// MITRE ATT&CK: T1003.001 (LSASS Memory), T1218 (Signed Binary Proxy Execution)
// False Positives: Legitimate administrative debugging, authorized memory dumps, security tooling

DeviceProcessEvents
| where FileName in~ ("rundll32.exe", "procdump.exe", "taskmgr.exe")
| where ProcessCommandLine has "lsass"
| project Timestamp, DeviceName, InitiatingProcessAccountName, FileName, ProcessCommandLine
